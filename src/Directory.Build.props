<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- NoWarn:
         * CA1822: member does not use instance data and can be static.
         * CS1591: missing XML comment on a publicly visible type or member.
         * xUnit1026: theory method does not use all of its parameters.
         * xUnit1013: public method on a test class is not marked as a test.
         * CS1573: parameter has no matching param tag in an XML comment that has others.
         * VerifyTestsProjectDir: use of the experimental VerifierSettings.ProjectDir.
         * VerifySetParameters: use of the experimental VerifySettings.SetParameters.
         * PolyfillTargetsForNuget: Polyfill asks a packed project to target every framework from
           its lowest up to net48.
         * xUnit1051: call that accepts a CancellationToken is not given
           TestContext.Current.CancellationToken.
         * NU1608: resolved package version is outside a dependency's version constraint.
         * NU1109: package downgrade detected for a centrally pinned transitive package.
         The IL codes are linker warnings from Squash about reflection over the types under test,
         which are never in the assembly being trimmed:
         * IL2026: call to a member marked RequiresUnreferencedCode.
         * IL2060: MethodInfo.MakeGenericMethod call that cannot be statically analyzed.
         * IL2070: reflection on a Type that came from a parameter with no
           DynamicallyAccessedMembers annotation.
         * IL2075: the same, where the Type came from a method's return value.
         * IL2077: the same, where the Type came from a field.
         * IL2111: method with DynamicallyAccessedMembers on its parameters or return value is
           reached through reflection. -->
    <NoWarn>CA1822;CS1591;xUnit1026;xUnit1013;CS1573;VerifyTestsProjectDir;VerifySetParameters;PolyfillTargetsForNuget;xUnit1051;NU1608;NU1109;IL2026;IL2060;IL2070;IL2075;IL2077;IL2111</NoWarn>
    <Version>33.3.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <PackageTags>Json, Testing, Verify, Snapshot, Approvals</PackageTags>
    <Description>Enables verification of complex models and documents.</Description>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PolyEnsure>true</PolyEnsure>
    <PolyStringInterpolation>true</PolyStringInterpolation>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ImportVerifyMsbuildFiles Condition="'$(MSBuildProjectName)' != '' And $(MSBuildProjectName.EndsWith('Tests'))">true</ImportVerifyMsbuildFiles>
    <!-- Work around https://github.com/dotnet/sdk/issues/51265#issuecomment-3407578810 -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <!-- The Roslyn version the MSTest source generator compiles against, and the analyzers
         folder Verify.MSTest packs it into. The two have to agree: a generator compiled
         against a higher version than its folder claims is loaded by every compiler in
         between and then skipped with CS9057, which silently disables [UsesVerify] and
         surfaces only as "TestContext is null" at run time. Kept here so neither can move
         without the other. Lower means more compilers are supported, so raise it only for
         an API the generator actually needs.
         https://learn.microsoft.com/en-us/visualstudio/extensibility/roslyn-version-support -->
    <VerifyRoslynVersion>4.4</VerifyRoslynVersion>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <!-- This directory contains two solutions (Verify.slnx and VerifyDangling.slnx), so Verify cannot
       auto-discover the solution when a project is built outside of a solution context. Default to the
       primary solution so standalone project builds resolve SolutionDirectory/SolutionName correctly.
       Solution builds pass these as global properties, which take precedence over these defaults. -->
  <PropertyGroup Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">
    <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
    <SolutionName>Verify</SolutionName>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Globalization" />
    <Using Include="System.Linq.Expressions" />
    <Using Include="System.Collections.Specialized" />
  </ItemGroup>
  <Import Condition="'$(ImportVerifyMsbuildFiles)' == 'true'"
          Project="$(MSBuildThisFileDirectory)Verify\buildTransitive\Verify.props" />
</Project>
